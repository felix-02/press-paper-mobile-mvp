# Presspaper is data-backed in every runtime environment. Fixture/demo mode is
# intentionally disabled so missing configuration can never expose fake data.
VITE_APP_MODE=live

# Copy to .env and fill in from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel server functions. These may match the VITE_ values above, but are kept
# separate so server configuration is explicit. Never prefix a service-role key
# with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PUBLIC_SITE_URL=https://presspaper.ai

# Optional: PostHog product analytics (free tier). Leave blank to disable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Edge Function secrets (set with `supabase secrets set`, not in Vercel
# frontend variables). SUPABASE_URL/keys are supplied by Supabase automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
